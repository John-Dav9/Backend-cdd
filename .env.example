# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URLS=https://cmciea-france.com,https://www.cmciea-france.com

# ── Auth JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Premier compte admin (créé automatiquement au démarrage si absent)
ADMIN_EMAIL=admin@cmciea-france.com
ADMIN_PASSWORD=change_this_strong_password

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=cmciea-postgres
DB_PORT=5432
DB_NAME=cmciea_db
DB_USER=cmciea_user
DB_PASSWORD=change_this_db_password

# ── MinIO (stockage fichiers) ─────────────────────────────────────────────────
MINIO_ENDPOINT=cmciea-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_this_minio_access_key
MINIO_SECRET_KEY=change_this_minio_secret_key
MINIO_BUCKET=cmciea

# ── Mail (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=contact@cmciea-france.com
MAIL_FROM_MARATHON=marathon@cmciea-france.com
MAIL_FROM_NEWS=news@cmciea-france.com
MAIL_REPLY_TO=contact@cmciea-france.com
MAIL_ADMIN=admin@cmciea-france.com

# ── IA Chat (Groq) ───────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
